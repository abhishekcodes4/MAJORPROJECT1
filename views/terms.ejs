<% layout("layouts/boilerplates") -%>

<div class="legal-page">

    <div class="legal-container">

        <!-- Header -->
        <div class="legal-header">

            <div class="legal-icon">
                <i class="fa-solid fa-file-contract"></i>
            </div>

            <h1>Terms and Conditions</h1>

            <p>
                Please read these terms carefully before using the
                Wanderlust platform.
            </p>

        </div>


        <!-- Content -->
        <div class="legal-content">

            <!-- Acceptance -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-circle-check"></i>
                    Acceptance of Terms
                </h2>

                <p>
                    By accessing or using Wanderlust, you agree to follow
                    these Terms and Conditions. If you do not agree with
                    these terms, please do not use the platform.
                </p>

            </section>


            <!-- User Accounts -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-user"></i>
                    User Accounts
                </h2>

                <p>
                    You are responsible for maintaining the security of your
                    account and for the information you provide when creating
                    and using your Wanderlust account.
                </p>

            </section>


            <!-- Listings -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-house"></i>
                    Listings
                </h2>

                <p>
                    Users who create listings are responsible for ensuring that
                    the information, descriptions, prices, images, and other
                    content they provide are accurate and appropriate.
                </p>

            </section>


            <!-- Reviews -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-star"></i>
                    Reviews and Content
                </h2>

                <p>
                    Reviews and other content posted on Wanderlust should be
                    respectful, relevant, and appropriate. Content that violates
                    platform rules may be removed.
                </p>

            </section>


            <!-- Responsibilities -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-scale-balanced"></i>
                    User Responsibilities
                </h2>

                <p>
                    You agree to use Wanderlust responsibly and not attempt to
                    misuse, damage, disrupt, or gain unauthorized access to
                    the platform or other users' accounts.
                </p>

            </section>


            <!-- Termination -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-ban"></i>
                    Account Termination
                </h2>

                <p>
                    Wanderlust may suspend or remove access to accounts that
                    violate these Terms and Conditions or misuse the platform.
                </p>

            </section>


            <!-- Changes -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-pen-to-square"></i>
                    Changes to These Terms
                </h2>

                <p>
                    We may update these Terms and Conditions when necessary.
                    Continued use of Wanderlust after changes are made means
                    that you accept the updated terms.
                </p>

            </section>

        </div>


        <!-- Back Button -->
        <div class="legal-footer">

            <a href="/listing" class="btn legal-home-btn">

                <i class="fa-solid fa-arrow-left"></i>
                Back to Explore

            </a>

        </div>

    </div>

</div>