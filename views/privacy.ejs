<% layout("layouts/boilerplates") -%>

<div class="legal-page">

    <div class="legal-container">

        <!-- Header -->
        <div class="legal-header">

            <div class="legal-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h1>Privacy Policy</h1>

            <p>
                Your privacy is important to us. This policy explains how
                Wanderlust collects, uses, and protects your information.
            </p>

        </div>


        <!-- Content -->

        <div class="legal-content">

            <!-- Information -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-user"></i>
                    Information We Collect
                </h2>

                <p>
                    When you create an account or use Wanderlust, we may collect
                    information such as your username, email address, listings,
                    reviews, and other information you choose to provide.
                </p>

            </section>


            <!-- Usage -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-chart-line"></i>
                    How We Use Your Information
                </h2>

                <p>
                    We use your information to provide and improve our services,
                    manage user accounts, display listings, process reviews, and
                    maintain the security of the Wanderlust platform.
                </p>

            </section>


            <!-- Cookies -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-cookie-bite"></i>
                    Cookies and Sessions
                </h2>

                <p>
                    Wanderlust may use cookies and sessions to keep you logged in,
                    improve your browsing experience, and help the platform
                    function properly.
                </p>

            </section>


            <!-- Data Sharing -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-share-nodes"></i>
                    Information Sharing
                </h2>

                <p>
                    We do not sell your personal information. Information may be
                    displayed publicly when you create listings or post reviews,
                    depending on how you use the platform.
                </p>

            </section>


            <!-- Security -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-lock"></i>
                    Data Security
                </h2>

                <p>
                    We take reasonable measures to protect your information.
                    However, no online platform can guarantee complete security
                    of information transmitted over the internet.
                </p>

            </section>


            <!-- Updates -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-pen-to-square"></i>
                    Changes to This Policy
                </h2>

                <p>
                    We may update this Privacy Policy from time to time.
                    Continued use of Wanderlust after changes are made means
                    that you accept the updated policy.
                </p>

            </section>


            <!-- Contact -->
            <section class="legal-section">

                <h2>
                    <i class="fa-solid fa-envelope"></i>
                    Contact Us
                </h2>

                <p>
                    If you have any questions about this Privacy Policy,
                    please contact the Wanderlust team.
                </p>

            </section>

        </div>


        <!-- Back Button -->

        <div class="legal-footer">

            <a href="/listing" class="btn legal-home-btn">

                <i class="fa-solid fa-arrow-left"></i>
                Back to Explore

            </a>

        </div>

    </div>

</div>