<% layout("layouts/boilerplates") -%>

<div class="form-page">

    <div class="form-container">

        <div class="form-header">
            <h2>Edit Listing</h2>
            <p>Update your listing information.</p>
        </div>

        <form
            method="POST"
            action="/listing/<%= listing._id %>?_method=PUT"
            novalidate
            class="needs-validation listing-form"
            enctype="multipart/form-data"
        >

            <!-- Title -->
            <div class="form-group">

                <label for="title" class="form-label">
                    Listing Title
                </label>

                <input
                    id="title"
                    name="listing[title]"
                    value="<%= listing.title %>"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a title.
                </div>

            </div>


            <!-- Description -->
            <div class="form-group">

                <label for="description" class="form-label">
                    Description
                </label>

                <textarea
                    id="description"
                    name="listing[description]"
                    class="form-control"
                    rows="5"
                    required
                ><%= listing.description %></textarea>

                <div class="invalid-feedback">
                    Please provide a description.
                </div>

            </div>


            <!-- Image -->
            <div class="form-group">

                <label for="image" class="form-label">
                    Change Image
                </label>

                <input
                    id="image"
                    name="listing[image]"
                    type="file"
                    class="form-control"
                    accept="image/*"
                >

                <small class="form-text">
                    Leave empty if you don't want to change the current image.
                </small>

            </div>


            <!-- Price and Country -->
            <div class="form-row">

                <div class="form-group">

                    <label for="price" class="form-label">
                        Price per Night (₹)
                    </label>

                    <input
                        id="price"
                        name="listing[price]"
                        value="<%= listing.price %>"
                        type="number"
                        min="0"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>

                </div>


                <div class="form-group">

                    <label for="country" class="form-label">
                        Country
                    </label>

                    <input
                        id="country"
                        name="listing[country]"
                        value="<%= listing.country %>"
                        type="text"
                        class="form-control"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a country name.
                    </div>

                </div>

            </div>


            <!-- Location -->
            <div class="form-group">

                <label for="location" class="form-label">
                    Location
                </label>

                <input
                    id="location"
                    name="listing[location]"
                    value="<%= listing.location %>"
                    type="text"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a location.
                </div>

            </div>


            <!-- Submit -->
            <button
                type="submit"
                class="btn edit-btn form-submit-btn"
            >
                <i class="fa-solid fa-floppy-disk"></i>
                Update Listing
            </button>

        </form>

    </div>

</div>